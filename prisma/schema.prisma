generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String?
  email        String    @unique
  refreshToken String?
  accessToken  String?   // Optional: might be short lived
  expiresAt    Int?
  isHost       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  requests     Request[]
  rooms        Room[]    // Rooms this user is a host of

  // Spotify app the user logged in with (null = default app from .env)
  spotifyApp   SpotifyApp? @relation(fields: [spotifyAppId], references: [id])
  spotifyAppId String?
}

// A host's own Spotify Developer app
model SpotifyApp {
  id                    String   @id @default(cuid())
  clientId              String   @unique
  clientSecretEncrypted String
  createdAt             DateTime @default(now())
  users                 User[]
}

model Room {
  id        String    @id @default(cuid())
  email     String    @unique // Host's Spotify email
  slug      String?   @unique // Public room URL (/slug), backfilled by getOrCreateRoom
  name      String?
  createdAt DateTime  @default(now())
  
  host      User      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  hostId    String
  
  requests  Request[]
  settings  RoomSetting[]
}

model Request {
  id          String   @id @default(cuid())
  spotifyUri  String
  title       String
  artist      String
  albumArt    String
  requestedBy String // Display name snapshot
  status      String   @default("PENDING") // PENDING, PLAYED, SKIPPED
  position    Int?      @default(0)
  createdAt   DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id])
  userId String?
  
  room   Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId String
}

model Setting {
  key   String @id
  value String
}

model RoomSetting {
  id    String @id @default(cuid())
  key   String
  value String
  
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId String
  
  @@unique([roomId, key])
}
